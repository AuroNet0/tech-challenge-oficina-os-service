diff --git a/scripts/artifact-release/test_gnutls_fixtures.py b/scripts/artifact-release/test_gnutls_fixtures.py
new file mode 100644
--- /dev/null
+++ b/scripts/artifact-release/test_gnutls_fixtures.py
@@ -0,0 +1,112 @@
+import io
+from pathlib import Path
+import tarfile
+import tempfile
+import unittest
+from unittest.mock import patch
+
+import release
+
+
+class GnutlsFixtureTests(unittest.TestCase):
+    def setUp(self):
+        self.key = b"-----BEGIN " + b"PRIVATE KEY-----\n" + b"A" * 64 + b"\n-----END PRIVATE KEY-----\n"
+        self.binary = b"\x7fELF\x02\x01" + b"\x00" * 10 + self.key + b"\x00"
+        self.path = "usr/lib/libgnutls.so.30.42.0"
+        self.policy = {"path": self.path, "layer_index": 1, "sha256": release.digest(self.binary),
+                       "base_diff_ids": ("sha256:" + "a" * 64, "sha256:" + "b" * 64),
+                       "fixtures": ((16, len(self.key), release.digest(self.key)),)}
+        self.addCleanup(patch.stopall)
+        patch.object(release, "GNUTLS_IMAGE_FIXTURE", self.policy).start()
+
+    def scan(self, content=None, path=None, service="os", layers=None, index=1):
+        return release._scan_gnutls_fixture(self.path if path is None else path,
+                                            self.binary if content is None else content, service,
+                                            self.policy["base_diff_ids"] if layers is None else layers, index)
+
+    def test_exact_fixture_in_verified_layer_is_classified(self):
+        self.scan()
+
+    def test_direct_scan_stays_strict(self):
+        with self.assertRaises(release.Rejected):
+            release.scan(self.path, self.binary)
+
+    def test_foreign_service_or_path_stays_strict(self):
+        for service, path in (("auth", self.path), ("execution", self.path), ("billing", self.path),
+                              ("os", "other/libgnutls.so.30.42.0"), ("os", "usr/lib/libgnutls.so.new")):
+            with self.subTest(service=service, path=path), self.assertRaises(release.Rejected):
+                self.scan(service=service, path=path)
+
+    def test_foreign_or_missing_base_stays_strict(self):
+        for layers in ((), ("sha256:" + "f" * 64,), tuple(reversed(self.policy["base_diff_ids"]))):
+            with self.subTest(layers=layers), self.assertRaises(release.Rejected):
+                self.scan(layers=layers)
+
+    def test_repeated_binary_in_later_layer_stays_strict(self):
+        with self.assertRaises(release.Rejected):
+            self.scan(index=2)
+
+    def test_changed_binary_or_fixture_stays_strict(self):
+        for content in (self.binary + b"x", self.binary.replace(b"A" * 64, b"B" * 64), self.binary.replace(b"ELF", b"BAD")):
+            with self.subTest(size=len(content)), self.assertRaises(release.Rejected):
+                self.scan(content)
+
+    def test_fixture_hash_is_independently_verified(self):
+        self.policy["fixtures"] = ((16, len(self.key), "f" * 64),)
+        with self.assertRaisesRegex(release.Rejected, "GNUTLS_FIXTURE_REJECTED"):
+            self.scan()
+
+    def test_fixture_offsets_are_independently_verified(self):
+        self.policy["fixtures"] = ((17, len(self.key), release.digest(self.key)),)
+        with self.assertRaisesRegex(release.Rejected, "GNUTLS_FIXTURE_LAYOUT_REJECTED"):
+            self.scan()
+
+    def test_appended_secrets_do_not_inherit_classification(self):
+        for extra in (self.key, b"AKIA" + b"Z" * 16, b"eyJ" + b"A" * 32 + b"." + b"B" * 32 + b"." + b"C" * 32):
+            with self.subTest(size=len(extra)), self.assertRaises(release.Rejected):
+                self.scan(self.binary + extra)
+
+    def test_remaining_content_is_scanned_even_with_mocked_binary_hash(self):
+        extra = b"AKIA" + b"Z" * 16
+        self.policy["sha256"] = release.digest(self.binary + extra)
+        with self.assertRaises(release.Rejected):
+            self.scan(self.binary + extra)
+
+    def test_image_verifier_accepts_only_scoped_fixture_and_rejects_later_secret(self):
+        def layer(entries):
+            stream = io.BytesIO()
+            with tarfile.open(fileobj=stream, mode="w") as archive:
+                for name, content in entries.items():
+                    member = tarfile.TarInfo(name)
+                    member.size = len(content)
+                    archive.addfile(member, io.BytesIO(content))
+            return stream.getvalue()
+        base_layers = [layer({"os-release": b"synthetic test"}), layer({self.path: self.binary})]
+        self.policy["base_diff_ids"] = tuple("sha256:" + release.digest(content) for content in base_layers)
+        revision = "a" * 40
+        for secret, accepted in ((False, True), (True, False)):
+            layers = base_layers + ([layer({"other/private.pem": self.key})] if secret else [])
+            config = release.canonical({"os": "linux", "architecture": "amd64",
+                "rootfs": {"type": "layers", "diff_ids": ["sha256:" + release.digest(content) for content in layers]},
+                "config": {"User": "10001", "Env": [], "Labels": {
+                    "org.opencontainers.image.source": "https://github.com/" + release.REPOSITORIES["os"],
+                    "org.opencontainers.image.revision": revision}}})
+            with self.subTest(secret=secret), tempfile.TemporaryDirectory() as folder:
+                image = Path(folder) / "image.tar"
+                layer_names = ["layer-" + str(index) + ".tar" for index in range(len(layers))]
+                entries = {"manifest.json": release.canonical([{"Config": "config.json", "Layers": layer_names}]),
+                           "config.json": config, **dict(zip(layer_names, layers))}
+                with tarfile.open(image, "w") as archive:
+                    for name, content in entries.items():
+                        member = tarfile.TarInfo(name)
+                        member.size = len(content)
+                        archive.addfile(member, io.BytesIO(content))
+                if accepted:
+                    release.verify_image_archive(image, "os", revision, "sha256:" + release.digest(config))
+                else:
+                    with self.assertRaises(release.Rejected):
+                        release.verify_image_archive(image, "os", revision, "sha256:" + release.digest(config))
+
+
+if __name__ == "__main__":
+    unittest.main()
