+def _scan_gnutls_fixture(name, content, service, diff_ids, layer_index):
+    policy = GNUTLS_IMAGE_FIXTURE
+    context = (service == "os" and name == policy["path"] and layer_index == policy["layer_index"]
+               and tuple(diff_ids[:len(policy["base_diff_ids"])]) == policy["base_diff_ids"]
+               and content.startswith(b"\x7fELF\x02\x01") and digest(content) == policy["sha256"])
+    if not context:
+        scan(name, content)
+        return
+    markers = list(re.finditer(rb"-----BEGIN " + rb"(?:[A-Z0-9]+ )?PRIVATE KEY-----", content))
+    require([match.start() for match in markers] == [entry[0] for entry in policy["fixtures"]], "GNUTLS_FIXTURE_LAYOUT_REJECTED")
+    classified = bytearray(content)
+    for offset, size, expected_sha256 in policy["fixtures"]:
+        payload = content[offset:offset + size]
+        require(digest(payload) == expected_sha256 and content[offset + size:offset + size + 1] == b"\x00", "GNUTLS_FIXTURE_REJECTED")
+        classified[offset:offset + size] = b"\x00" * size
+    scan(name, bytes(classified))
+
